{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@middleware/*": [
        "./src/middleware/*"
      ],
      "@controller/*": [
        "./src/controller/*"
      ],
      "@routes/*": [
        "./src/routes/*"
      ],
    }
  },
  "include": [
    "server.ts",
    "src/**/*.ts"
  ]
}